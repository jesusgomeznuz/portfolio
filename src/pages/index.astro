    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0c0c0e;
        --surface: #131316;
        --surface-hover: #1a1a1f;
        --border: #232328;
        --border-hover: #333340;
        --text: #ececec;
        --muted: #777780;
        --muted-bright: #9999a8;
        --accent: #b8e832;
        --font: 'Inter', system-ui, -apple-system, sans-serif;
      }

      html { background: var(--bg); }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        display: grid;
        grid-template-columns: 1fr min(692px, calc(100% - 48px)) 1fr;
      }
      .container > * { grid-column: 2; }

      /* NAV */
      .nav-wrapper { border-bottom: 1px solid var(--border); }
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
      }
      nav .name { font-weight: 600; font-size: 14px; letter-spacing: -0.01em; }
      nav .links { display: flex; gap: 20px; }
      nav .links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
        transition: color 0.15s;
      }
      nav .links a:hover { color: var(--text); }

      /* HERO */
      .hero { padding: 80px 0 64px; }
      .hero h1 {
        font-size: clamp(36px, 6vw, 52px);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin-bottom: 20px;
      }
      .hero h1 .line2 { color: var(--accent); display: block; }
      .hero p {
        color: var(--muted-bright);
        font-size: 17px;
        line-height: 1.65;
        max-width: 480px;
      }
      .hero .badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 28px;
      }
      .badge {
        font-size: 12px;
        font-weight: 500;
        color: var(--muted);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 4px 12px;
        letter-spacing: 0.01em;
      }

      /* STORY */
      .story {
        padding: 48px 0 40px;
      }
      .story p {
        color: var(--muted-bright);
        font-size: 16px;
        line-height: 1.75;
        max-width: 560px;
        margin-bottom: 16px;
      }
      .story p:last-child { margin-bottom: 0; }
      .story p strong {
        color: var(--text);
        font-weight: 500;
      }

      /* PROJECT CARD */
      .project {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 24px 28px;
        margin-bottom: 48px;
        transition: border-color 0.2s, background 0.2s;
      }
      .project:hover {
        border-color: var(--border-hover);
        background: var(--surface-hover);
      }
      .project-header {
        margin-bottom: 8px;
      }
      .project h2 { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
      .project p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 0;
      }
      .project-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 20px;
        padding: 12px 16px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s;
      }
      .project-link:hover {
        border-color: var(--accent);
        background: rgba(184, 232, 50, 0.04);
      }
      .project-link .link-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--muted-bright);
        transition: color 0.2s;
      }
      .project-link:hover .link-label { color: var(--accent); }
      .project-link .link-arrow {
        font-size: 16px;
        color: var(--muted);
        transition: color 0.2s, transform 0.2s;
      }
      .project-link:hover .link-arrow { color: var(--accent); transform: translateX(3px); }

      /* TAGS */
      .tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 14px;
      }
      .tag {
        font-size: 11px;
        font-weight: 500;
        color: var(--muted);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 2px 8px;
        letter-spacing: 0.02em;
      }

      /* FOOTER */
      footer {
        border-top: 1px solid var(--border);
        padding: 28px 0 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 13px;
        gap: 16px;
      }
      footer a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
      footer a:hover { color: var(--muted-bright); }

      @media (max-width: 520px) {
        .hero h1 { font-size: 34px; }
        .project { padding: 20px; }
        footer { flex-direction: column; align-items: flex-start; gap: 6px; }
      }
    </style>
  </head>
