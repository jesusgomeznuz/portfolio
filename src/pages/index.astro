---
import ProjectWorkbench from '../components/ProjectWorkbench';
import { canicasbrawlFlow } from '../data/flow-tree';
import { canicasbrawlDiagrams } from '../data/flow-diagrams';

const DEMO_URL = import.meta.env.DEV
  ? 'http://localhost:5173'
  : 'https://react-rapier.vercel.app'   // reemplazar con URL real al deployar
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Juan Jesús Gómez — Physics / Gameplay Programmer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Permanent+Marker&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html, body { height: 100%; background: #0c0c0e; }

      body {
        color: #ececec;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }

      a { color: #b8e832; text-decoration: none; }
      a:hover { color: #cff05a; }

      /* FULL-BLEED SHELL */
      .shell {
        width: 100vw;
        height: 100vh;
        background: #0c0c0e;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      /* TOP EDGE */
      .top-edge {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 14px 26px;
        border-bottom: 1px solid #1a1a1e;
        flex-wrap: wrap;
        flex-shrink: 0;
      }
      .top-edge .who { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
      .top-edge .who .name { font: 800 18px Inter; color: #f4f4f6; letter-spacing: -.02em; }
      .top-edge .who .role { font: 600 12px Inter; color: #b8e832; }
      .top-edge .who .location { font: 400 10px 'JetBrains Mono', monospace; color: #78787f; }
      .top-edge .actions { display: flex; align-items: center; gap: 9px; }
      .top-edge .actions .stack { font: 400 10px 'JetBrains Mono', monospace; color: #78787f; }
      .btn { font: 600 12px Inter; padding: 7px 13px; border-radius: 7px; }
      .btn-primary { background: #b8e832; color: #0c0c0e; }
      .btn-secondary { border: 1px solid #2b2b31; color: #ededf0; }

      /* MAIN: left edge rail + huge viewer */
      .main-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 212px 1fr;
      }

      /* LEFT EDGE — identity + trajectory */
      .identity {
        border-right: 1px solid #1a1a1e;
        padding: 20px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
      }
      .identity .positioning { font: 400 12.5px/1.5 Inter; color: #cfcfd5; margin: 0; }
      .identity .chips { display: flex; gap: 7px; margin-top: 14px; flex-wrap: wrap; }
      .chip { padding: 4px 9px; border: 1px solid #2b2b31; border-radius: 999px; font: 600 9.5px 'JetBrains Mono', monospace; }
      .chip.accent { color: #b8e832; }
      .chip.muted { color: #b7b7bf; }
      .section-title {
        font: 600 10px/1 'JetBrains Mono', monospace;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #6f6f78;
        margin: 24px 0 14px;
      }
      .acts { display: flex; flex-direction: column; }
      .act { display: grid; grid-template-columns: 26px 1fr; gap: 10px; padding: 13px 0; border-bottom: 1px solid #17171b; }
      .act:first-child { padding-top: 0; }
      .act:last-child { border-bottom: none; padding-bottom: 0; }
      .act .num { font: 800 15px/1 'JetBrains Mono', monospace; color: #b8e832; }
      .act .title { font: 700 12.5px Inter; color: #ededf0; }
      .act .body { font: 400 11px/1.45 Inter; color: #9c9ca4; margin: 4px 0 0; }
      .act .body .mono { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: #cdd3c0; }
      .act .body .cta { color: #b8e832; }
      .identity-footer {
        margin-top: auto;
        padding-top: 16px;
        font: 400 9.5px/1.5 'JetBrains Mono', monospace;
        color: #5f5f66;
      }

      @media (max-width: 860px) {
        body { overflow: auto; }
        .shell { height: auto; min-height: 100vh; }
        .main-grid { grid-template-columns: 1fr; }
        .identity { border-right: none; border-bottom: 1px solid #1a1a1e; }
      }
    </style>
  </head>
  <body>

    <div class="shell">
      <div class="top-edge">
        <div class="who">
          <span class="name">Juan Jesús Gómez Núñez</span>
          <span class="role">Physics &amp; gameplay programmer</span>
          <span class="location">México · remoto UK / EU</span>
        </div>
        <div class="actions">
          <span class="stack">Rust · Bevy · Rapier · C#/Unity</span>
          <a class="btn btn-primary" href="mailto:jesus.gomeznuz@gmail.com">Email</a>
          <a class="btn btn-secondary" href="https://github.com/jesusgomeznuz" target="_blank">GitHub</a>
          <a class="btn btn-secondary" href="/cv.pdf" target="_blank">CV</a>
        </div>
      </div>

      <div class="main-grid">
        <div class="identity">
          <p class="positioning">No soy otro dev pidiendo trabajo. Lo que construí se volvió viral por mi cuenta — y Londres me contrató para llevarlo a producción.</p>

          <div class="chips">
            <span class="chip accent">Ex-Jammable · Londres</span>
            <span class="chip muted">videos virales</span>
          </div>

          <h2 class="section-title">La trayectoria</h2>
          <div class="acts">
            <div class="act">
              <div class="num">01</div>
              <div>
                <div class="title">Canicas virales</div>
                <p class="body">Descubrí solo el método viral con simulaciones en Rust.</p>
              </div>
            </div>
            <div class="act">
              <div class="num">02</div>
              <div>
                <div class="title">Jammable — Londres</div>
                <p class="body">Engine con Rapier + Rust: física local, renders on-device. Viral a escala en un producto real.</p>
              </div>
            </div>
            <div class="act">
              <div class="num">03</div>
              <div>
                <div class="title">Engine propio</div>
                <p class="body"><span class="mono">rapier-bevy</span> + dos juegos. <span class="cta">Explóralos →</span></p>
              </div>
            </div>
          </div>

          <div class="identity-footer">Elegí un proyecto arriba →<br>demo y flujo de código en el mismo lugar.</div>
        </div>

        <ProjectWorkbench client:load demoUrl={DEMO_URL} canicasFlow={canicasbrawlFlow} canicasDiagrams={canicasbrawlDiagrams} />
      </div>
    </div>

  </body>
</html>
