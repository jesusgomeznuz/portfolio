---
import MusicalDemo from '../components/musical-demo/MusicalDemo';
import '../styles/tokens.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Musical Path — demo en vivo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');
    </script>
    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: 28px 16px 40px;
      }
      .page-title { font: 700 22px Futura, Jost, sans-serif; letter-spacing: -0.02em; }
      .page-subtitle {
        font: 400 13px Jost, sans-serif;
        color: var(--muted);
        text-align: center;
        max-width: 560px;
      }
      .demo-frame { width: min(92vw, 46vh); }
      .back { font: 400 12px Jost, sans-serif; }
    </style>
  </head>
  <body>
    <a class="back" href="/">← portfolio</a>
    <h1 class="page-title">Musical Path</h1>
    <p class="page-subtitle">
      El inverso de CanicasBrawl: aquí no hay física — la trayectoria ES la canción. Cada rebote
      cae en un beat, cada galleta cambia la voz, las bombas rompen la pared en los golpes fuertes.
    </p>
    <div class="demo-frame">
      <MusicalDemo client:only="react" />
    </div>
  </body>
</html>
